void Theme::apply()
{
    ImGuiStyle& style = ImGui::GetStyle();

    // ── Spacing & rounding ──────────────────────────────────
    // Varied for rhythm, not uniform
    style.WindowPadding    = ImVec2(14.0f, 12.0f);
    style.FramePadding     = ImVec2(10.0f, 5.0f);
    style.ItemSpacing      = ImVec2(8.0f, 7.0f);
    style.ItemInnerSpacing = ImVec2(6.0f, 4.0f);
    style.IndentSpacing    = 18.0f;
    style.ScrollbarSize    = 11.0f;
    style.GrabMinSize      = 8.0f;

    style.WindowRounding    = 6.0f;
    style.ChildRounding     = 5.0f;
    style.FrameRounding     = 4.0f;
    style.PopupRounding     = 5.0f;
    style.ScrollbarRounding = 4.0f;
    style.GrabRounding      = 3.0f;
    style.TabRounding       = 4.0f;

    style.WindowBorderSize = 1.0f;
    style.ChildBorderSize  = 1.0f;
    style.FrameBorderSize  = 0.0f;
    style.PopupBorderSize  = 1.0f;
    style.TabBorderSize    = 0.0f;

    style.WindowTitleAlign = ImVec2(0.0f, 0.5f);
    style.SelectableTextAlign = ImVec2(0.0f, 0.5f);

    // ── Colors ──────────────────────────────────────────────
    ImVec4* c = style.Colors;

    c[ImGuiCol_Text]             = C::Text;
    c[ImGuiCol_TextDisabled]     = C::TextDim;
    c[ImGuiCol_WindowBg]         = C::WindowBg;
    c[ImGuiCol_ChildBg]          = C::ChildBg;
    c[ImGuiCol_PopupBg]          = C::PopupBg;
    c[ImGuiCol_Border]           = C::Border;
    c[ImGuiCol_BorderShadow]     = ImVec4(0, 0, 0, 0);

    c[ImGuiCol_FrameBg]          = C::FrameBg;
    c[ImGuiCol_FrameBgHovered]   = C::FrameHov;
    c[ImGuiCol_FrameBgActive]    = C::FrameAct;

    c[ImGuiCol_TitleBg]          = C::TitleBg;
    c[ImGuiCol_TitleBgActive]    = C::TitleBg;
    c[ImGuiCol_TitleBgCollapsed] = C::TitleBg;

    c[ImGuiCol_CheckMark]        = C::Accent;

    c[ImGuiCol_SliderGrab]       = C::Accent;
    c[ImGuiCol_SliderGrabActive] = ImVec4(C::Accent.x + 0.05f, C::Accent.y + 0.05f, C::Accent.z + 0.05f, 1.0f);

    c[ImGuiCol_Button]           = C::FrameBg;
    c[ImGuiCol_ButtonHovered]    = C::AccentFaint;
    c[ImGuiCol_ButtonActive]     = C::AccentDim;

    c[ImGuiCol_Header]           = C::AccentFaint;
    c[ImGuiCol_HeaderHovered]    = C::AccentDim;
    c[ImGuiCol_HeaderActive]     = ImVec4(C::Accent.x, C::Accent.y, C::Accent.z, 0.45f);

    c[ImGuiCol_Separator]        = C::BorderLite;
    c[ImGuiCol_SeparatorHovered] = C::AccentDim;
    c[ImGuiCol_SeparatorActive]  = C::Accent;

    c[ImGuiCol_ResizeGrip]       = ImVec4(0, 0, 0, 0);
    c[ImGuiCol_ResizeGripHovered]= C::AccentFaint;
    c[ImGuiCol_ResizeGripActive] = C::AccentDim;

    c[ImGuiCol_Tab]              = C::FrameBg;
    c[ImGuiCol_TabHovered]       = C::AccentFaint;
    c[ImGuiCol_TabSelected]      = C::ChildBg;
    c[ImGuiCol_TabDimmed]        = C::TitleBg;
