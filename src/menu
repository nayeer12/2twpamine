// ── Custom toggle rendering ──────────────────────────────────
// A clean pill-style toggle instead of a checkbox.
// No side-stripe borders; uses full background tint.
static void drawToggle(ImDrawList* dl, const ImVec2& pos, float w, float h, bool on)
{
    ImVec2 pmin = pos;
    ImVec2 pmax = ImVec2(pos.x + w, pos.y + h);
    ImU32 bg = on ? IM_COL32(234, 176, 72, 200) : IM_COL32(28, 23, 18, 255);
    ImU32 border = on ? IM_COL32(234, 176, 72, 255) : IM_COL32(50, 42, 33, 255);

    dl->AddRectFilled(pmin, pmax, bg, h * 0.5f);
    dl->AddRect(pmin, pmax, border, h * 0.5f, 0, 1.0f);

    // Knob
    float knobR = h * 0.35f;
    float knobX = on ? (pos.x + w - h * 0.5f) : (pos.x + h * 0.5f);
    float knobY = pos.y + h * 0.5f;
    ImU32 knobCol = on ? IM_COL32(255, 245, 227, 255) : IM_COL32(120, 110, 95, 255);
    dl->AddCircleFilled(ImVec2(knobX, knobY), knobR, knobCol);
}

void Menu::render()
{
    // Window setup — fixed compact size, no resize
    ImGuiIO& io = ImGui::GetIO();

    ImGui::SetNextWindowSize(ImVec2(348, 0), ImGuiCond_FirstUseEver);
    ImGui::SetNextWindowPos(ImVec2(60, 60), ImGuiCond_FirstUseEver);

    ImGuiWindowFlags flags =
        ImGuiWindowFlags_NoCollapse |
        ImGuiWindowFlags_NoResize |
        ImGuiWindowFlags_AlwaysAutoResize |
        ImGuiWindowFlags_NoNav;

    if (!ImGui::Begin("ytclient", nullptr, flags))
    {
        ImGui::End();
        return;
    }

    // ── Tab bar ─────────────────────────────────────────────
    // Flat, compact category navigation
    static const char* tabNames[] = {
        "Movement", "Combat", "Player", "Render", "World", "Misc"
    };
    static const Category tabCats[] = {
        Category::Movement, Category::Combat, Category::Player,
        Category::Render, Category::World, Category::Misc
    };

    if (ImGui::BeginTabBar("##tabs", ImGuiTabBarFlags_None))
    {
        for (int i = 0; i < 6; i++)
        {
            if (ImGui::BeginTabItem(tabNames[i]))
            {
                m_activeTab = i;
                auto& mods = ModuleManager::instance().getByCategory(tabCats[i]);

                ImGui::Spacing();

                if (mods.empty())
                {
                    ImGui::TextDisabled("  No modules in this category");
                }
                else
                {
                    for (size_t j = 0; j < mods.size(); j++)
                    {
                        renderModuleRow(mods[j], (int)j);
                    }
                }

                ImGui::Spacing();
                ImGui::EndTabItem();
            }
        }
        ImGui::EndTabBar();
    }

    renderStatusBar();

    ImGui::End();
}

void Menu::renderModuleRow(Module* mod, int idx)
{
    ImGui::PushID(idx);

    ImVec2 rowMin = ImGui::GetCursorScreenPos();
    float availW = ImGui::GetContentRegionAvail().x;

    // Background row — subtle alternating tint, no side-stripe
    ImDrawList* dl = ImGui::GetWindowDrawList();
    float rowH = 26.0f;

    ImU32 rowBg = (idx % 2 == 0)
        ? IM_COL32(255, 255, 255, 4)
        : IM_COL32(0, 0, 0, 0);

    if (mod->isEnabled())
        rowBg = IM_COL32(234, 176, 72, 12);

    dl->AddRectFilled(
        rowMin,
        ImVec2(rowMin.x + availW, rowMin.y + rowH),
        rowBg, 3.0f);

    // Toggle
    ImGui::SetCursorScreenPos(ImVec2(rowMin.x + 8, rowMin.y + 5));
    ImGui::InvisibleButton(("##toggle_" + mod->name()).c_str(), ImVec2(36, 16));

    if (ImGui::IsItemClicked())
        mod->toggle();

    // Draw toggle visual on top
    drawToggle(dl, ImGui::GetItemRectMin(), 36.0f, 16.0f, mod->isEnabled());

    // Module name
    ImGui::SameLine(0, 12.0f);
    ImGui::SetCursorPosY(rowMin.y + 4);

    ImGui::PushStyleColor(ImGuiCol_Text,
        mod->isEnabled() ? Theme::C::TextBright : Theme::C::Text);
    ImGui::TextUnformatted(mod->name().c_str());
    ImGui::PopStyleColor();

    // Settings toggle indicator (chevron)
    bool hasSettings = !mod->settings().empty();
    if (hasSettings)
    {
        ImGui::SameLine(availW - 20.0f);
        ImGui::SetCursorPosY(rowMin.y + 5);
        ImGui::TextDisabled(mod->isEnabled() ? ">" : "");
    }

    ImGui::SetCursorScreenPos(ImVec2(rowMin.x, rowMin.y + rowH));

    // Inline settings when enabled
    if (mod->isEnabled() && hasSettings)
    {
        ImGui::Indent(48.0f);
        for (size_t s = 0; s < mod->settings().size(); s++)
        {
            renderSetting(mod->settings()[s], (int)s);
        }
        ImGui::Unindent(48.0f);
        ImGui::Spacing();
    }

    ImGui::PopID();
}

void Menu::renderSetting(Setting& s, int modIdx)
{
    ImGui::PushID(modIdx);

    switch (s.type)
    {
    case SettingType::Bool:
        ImGui::Checkbox(s.name.c_str(), &s.boolVal);
        break;

    case SettingType::Float:
    {
        ImGui::TextDisabled("%s", s.name.c_str());
        ImGui::SameLine();
        ImGui::PushItemWidth(-1);
        ImGui::SliderFloat(("##" + s.name).c_str(), &s.floatVal, s.floatMin, s.floatMax, "%.2f");
        ImGui::PopItemWidth();
        break;
    }

    case SettingType::Int:
    {
        ImGui::TextDisabled("%s", s.name.c_str());
        ImGui::SameLine();
        ImGui::PushItemWidth(-1);
        ImGui::SliderInt(("##" + s.name).c_str(), &s.intVal, s.intMin, s.intMax);
        ImGui::PopItemWidth();
        break;
    }

    case SettingType::Keybind:
        ImGui::TextDisabled("%s: %d", s.name.c_str(), s.keyVal);
        break;
    }

    ImGui::PopID();
}

void Menu::renderStatusBar()
{
    ImGui::Spacing();
    ImGui::Separator();

    auto& mods = ModuleManager::instance().all();
    int active = 0;
    for (auto& m : mods)
        if (m->isEnabled()) active++;

    ImGuiIO& io = ImGui::GetIO();

    ImGui::Dummy(ImVec2(0, 2));
    ImGui::PushStyleColor(ImGuiCol_Text, Theme::C::TextDim);
    ImGui::Text(" %zu modules  |  %d active  |  %.0f FPS",
        mods.size(), active, io.Framerate);
    ImGui::PopStyleColor();
}

