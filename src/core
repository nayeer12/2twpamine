// ════════════════════════════════════════════════════════════
//  Init — called from the background init thread.
//  Sets up the MinHook on wglSwapBuffers so that every
//  subsequent frame hits our hook.
// ════════════════════════════════════════════════════════════
bool Hooks::init()
{
    m_opengl32 = GetModuleHandleA("opengl32.dll");
    if (!m_opengl32)
    {
        OutputDebugStringA("ytclient: opengl32.dll not loaded\n");
        return false;
    }

    void* target = (void*)GetProcAddress(m_opengl32, "wglSwapBuffers");
    if (!target)
    {
        OutputDebugStringA("ytclient: wglSwapBuffers not found\n");
        return false;
    }

    MH_STATUS s = MH_Initialize();
    if (s != MH_OK && s != MH_ERROR_ALREADY_INITIALIZED)
    {
        char buf[128];
        snprintf(buf, sizeof(buf), "ytclient: MH_Initialize failed: %d\n", s);
        OutputDebugStringA(buf);
        return false;
    }

    s = MH_CreateHook(target, (void*)&hkSwapBuffers, &m_origSwap);
    if (s != MH_OK)
    {
        char buf[128];
        snprintf(buf, sizeof(buf), "ytclient: MH_CreateHook failed: %d\n", s);
        OutputDebugStringA(buf);
        return false;
    }

    s = MH_EnableHook(target);
    if (s != MH_OK)
    {
        char buf[128];
        snprintf(buf, sizeof(buf), "ytclient: MH_EnableHook failed: %d\n", s);
        OutputDebugStringA(buf);
        return false;
    }

    m_hookOK = true;
    OutputDebugStringA("ytclient: wglSwapBuffers hooked\n");
    return true;
}

void Hooks::shutdown()
{
    if (!m_hookOK) return;

    void* target = (void*)GetProcAddress(m_opengl32, "wglSwapBuffers");
    if (target) MH_DisableHook(target);
    MH_Uninitialize();
    m_hookOK = false;

    if (m_imguiInit)
    {
        ImGui_ImplOpenGL3_Shutdown();
        ImGui_ImplWin32_Shutdown();
        ImGui::DestroyContext();
        m_imguiInit = false;
    }

    // Restore WndProc
    if (m_origWndProc && m_hwnd)
    {
        SetWindowLongPtr(m_hwnd, GWLP_WNDPROC, (LONG_PTR)m_origWndProc);
    }

    OutputDebugStringA("ytclient: shutdown\n");
}

// ════════════════════════════════════════════════════════════
//  ImGui init — runs on the RENDER THREAD inside hkSwapBuffers.
//  The OpenGL context is guaranteed to be current here.
// ════════════════════════════════════════════════════════════
void Hooks::initImGui(HDC hdc)
{
    // Safety: we must have a valid GL context
    if (!wglGetCurrentContext())
    {
        OutputDebugStringA("ytclient: initImGui: no GL context, will retry\n");
        return;  // m_imguiInit stays false, hkSwapBuffers will retry
    }

    OutputDebugStringA("ytclient: initImGui starting\n");

    IMGUI_CHECKVERSION();
    ImGui::CreateContext();
    ImGuiIO& io = ImGui::GetIO();
    io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
    io.IniFilename = nullptr;  // don't write imgui.ini

    // Font loading (best-effort, falls back to default)
    io.Fonts->Clear();
    io.Fonts->AddFontDefault();
    ImFont* font = io.Fonts->AddFontFromFileTTF(
        "C:\\Windows\\Fonts\\segoeui.ttf", 15.0f);
    if (font)
    {
        io.FontDefault = font;
        io.Fonts->Build();
    }
    else
    {
        // Default font is already loaded
        io.Fonts->Build();
    }

    Theme::apply();

    // Get the game window from the DC
    m_hwnd = WindowFromDC(hdc);

    // Validate the window handle
    if (!m_hwnd || m_hwnd == GetDesktopWindow())
    {
        OutputDebugStringA("ytclient: initImGui: invalid HWND\n");
        m_imguiFailed = true;
        return;
    }

    char className[128] = {};
    GetClassNameA(m_hwnd, className, sizeof(className));
    OutputDebugStringA(("ytclient: game HWND class: " + std::string(className) + "\n").c_str());

    // Init ImGui backends
    if (!ImGui_ImplWin32_Init(m_hwnd))
    {
        OutputDebugStringA("ytclient: ImGui_ImplWin32_Init failed\n");
        m_imguiFailed = true;
        return;
    }

    if (!ImGui_ImplOpenGL3_Init(nullptr))
    {
        OutputDebugStringA("ytclient: ImGui_ImplOpenGL3_Init failed\n");
        m_imguiFailed = true;
        return;
    }

    // Hook WndProc for input capture
    setupWndProcHook(m_hwnd);

    m_imguiInit = true;
    OutputDebugStringA("ytclient: ImGui initialized successfully\n");
}

void Hooks::setupWndProcHook(HWND hwnd)
{
    m_origWndProc = (WNDPROC)GetWindowLongPtr(hwnd, GWLP_WNDPROC);
    SetWindowLongPtr(hwnd, GWLP_WNDPROC, (LONG_PTR)&hkWndProc);
    OutputDebugStringA("ytclient: WndProc hooked\n");
}

// ════════════════════════════════════════════════════════════
//  ImGui render — called every frame if ImGui is initialized
// ════════════════════════════════════════════════════════════
void Hooks::renderImGui()
{
    if (!m_imguiInit) return;

    ImGui_ImplOpenGL3_NewFrame();
    ImGui_ImplWin32_NewFrame();
    ImGui::NewFrame();

    if (onRender)
        onRender();

    ImGui::Render();
    ImGui_ImplOpenGL3_RenderDrawData(ImGui::GetDrawData());
}

// ════════════════════════════════════════════════════════════
//  wglSwapBuffers hook — runs on the RENDER THREAD every frame
// ════════════════════════════════════════════════════════════
BOOL WINAPI Hooks::hkSwapBuffers(HDC hdc)
{
    auto& self = instance();

    // ── First-frame init ─────────────────────────────────────
    if (!self.m_imguiInit && !self.m_imguiFailed)
    {
        if (!self.m_firstFrameDone)
        {
            self.m_firstFrameDone = true;
            OutputDebugStringA("ytclient: first frame received\n");

            // Wire callbacks on the render thread (GL context is current here)
            Client::instance().onFirstFrame();
        }

        // Try to init ImGui. If the GL context isn't ready yet,
        // we'll retry on the next frame (up to 300 retries).
        self.initImGui(hdc);
        self.m_imguiRetries++;

        if (self.m_imguiRetries > 300)
        {
            OutputDebugStringA("ytclient: initImGui gave up after 300 retries\n");
            self.m_imguiFailed = true;
        }

        // If we just succeeded, log it and let renderImGui run below
        if (self.m_imguiInit)
        {
            OutputDebugStringA("ytclient: ImGui ready, HUD will now render\n");
        }
    }

    // ── Render HUD / menu ────────────────────────────────────
    self.renderImGui();

    // ── Frame-counting tick fallback ──────────────────────────
    if (self.onTickFallback)
        self.onTickFallback();

    // ── Call the original wglSwapBuffers ──────────────────────
    typedef BOOL(WINAPI* FnSwap)(HDC);
    return ((FnSwap)self.m_origSwap)(hdc);
}

// ════════════════════════════════════════════════════════════
//  WndProc hook — routes input to ImGui when menu is open
// ════════════════════════════════════════════════════════════
LRESULT WINAPI Hooks::hkWndProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam)
{
    auto& self = instance();

    if (self.m_imguiInit)
    {
        if (ImGui_ImplWin32_WndProcHandler(hWnd, msg, wParam, lParam))
            return true;

        if (self.m_menuVisible)
        {
            switch (msg)
            {
            case WM_KEYDOWN:
            case WM_KEYUP:
            case WM_SYSKEYDOWN:
            case WM_SYSKEYUP:
            case WM_LBUTTONDOWN:
            case WM_LBUTTONUP:
            case WM_RBUTTONDOWN:
            case WM_RBUTTONUP:
            case WM_MBUTTONDOWN:
            case WM_MBUTTONUP:
            case WM_MOUSEWHEEL:
            case WM_MOUSEMOVE:
            case WM_CHAR:
            case WM_INPUT:
                return true;
            }
        }
    }

    if (self.m_origWndProc)
        return CallWindowProc(self.m_origWndProc, hWnd, msg, wParam, lParam);

    return DefWindowProc(hWnd, msg, wParam, lParam);
}

