Client& Client::instance()
{
    static Client inst;
    return inst;
}

// ════════════════════════════════════════════════════════════
//  Entry — called from DllMain (DLL_PROCESS_ATTACH)
//  Creates the background init thread.
// ════════════════════════════════════════════════════════════
void Client::startThread()
{
    m_thread = std::thread([this]() { run(); });
}

// ════════════════════════════════════════════════════════════
//  Startup — runs on the background init thread
// ════════════════════════════════════════════════════════════
void Client::run()
{
    Logger::init();

    // Allocate a console so the user can see diagnostic output
    if (AllocConsole())
    {
        FILE* out = nullptr;
        FILE* err = nullptr;
        freopen_s(&out, "CONOUT$", "w", stdout);
        freopen_s(&err, "CONOUT$", "w", stderr);
        SetConsoleTitleW(L"ytclient");
    }

    printf("ytclient injected into process\n");
    printf("Log file: %s\n", Logger::getLogPath().c_str());
    printf("Waiting for first frame to init ImGui...\n");
    OutputDebugStringA("ytclient: DLL loaded\n");

    // Hook MUST be set up as fast as possible so the first frame gets intercepted.
    // This must happen BEFORE any blocking or JVM work.
    if (!Hooks::instance().init())
    {
        printf("FATAL: wglSwapBuffers hook failed\n");
        OutputDebugStringA("ytclient: hook init failed\n");
        return;
    }
    printf("wglSwapBuffers hook installed. Waiting for JVM...\n");

    // ── JVM setup (best-effort, non-blocking for the hook) ──────
    if (initJVM())
    {
        initTickHook();
        initModules();
        printf("ytclient fully loaded — %zu modules registered\n",
            ModuleManager::instance().size());
    }
    else
    {
        printf("WARNING: JVM init failed. Modules will be unavailable.\n");
    }

    m_ready = true;
    m_running = true;

    // Idle loop — keeps the init thread alive
    while (m_running.load())
        Sleep(500);
}

bool Client::initJVM()
{
    if (!JVM::instance().attach())
    {
        printf("JVM attach failed (is the game running?)\n");
        OutputDebugStringA("ytclient: JVM attach failed\n");
        return false;
    }
    printf("JVM attached successfully\n");

    // Retry MinecraftClient resolution a few times (game may still be loading)
    for (int i = 0; i < 15; i++)
    {
        if (JVM::instance().getMinecraft())
        {
            printf("MinecraftClient instance resolved\n");
            strcpy_s(m_hudMessage, "ytclient loaded");
            return true;
        }
        printf("Waiting for MinecraftClient... (%d/15)\n", i + 1);
        Sleep(500);
    }

    printf("Could not resolve MinecraftClient instance\n");
    return false;
}

bool Client::initTickHook()
{
    JVM::instance().setTickCallback([this]() { onTick(); });
    if (JVM::instance().hookTick())
    {
        printf("Tick hook active (JVMTI breakpoint)\n");
        return true;
    }
    printf("JVMTI tick hook unavailable; using frame fallback\n");
    return false;
}

void Client::initModules()
{
    auto& mgr = ModuleManager::instance();
    mgr.add<Speed>();
    mgr.add<Fly>();
    mgr.add<NoFall>();
    mgr.add<Sprint>();
    mgr.add<KillAura>();
    mgr.add<Reach>();
    mgr.add<FullBright>();
}

// ════════════════════════════════════════════════════════════
//  First frame — called from hkSwapBuffers (RENDER THREAD)
//  This wires the render callback so the HUD/menu draw.
// ════════════════════════════════════════════════════════════
void Client::onFirstFrame()
{
    OutputDebugStringA("ytclient: first frame, wiring callbacks\n");

    Hooks::instance().onRender = [this]() { onRender(); };

    // Callback for the frame-counting tick fallback
    if (!JVM::instance().jvmti())
    {
        Hooks::instance().onTickFallback = [this]() { onTickFallback(); };
        m_lastTickTime = GetTickCount();
        OutputDebugStringA("ytclient: frame-counting tick fallback active\n");
    }
}

// ════════════════════════════════════════════════════════════
//  Per-frame render callback (RENDER THREAD)
// ════════════════════════════════════════════════════════════
void Client::onRender()
{
    // RightShift toggle — always operational, even before m_ready
    static bool rshiftPrev = false;
    bool rshiftNow = (GetAsyncKeyState(VK_RSHIFT) & 0x8000) != 0;
    if (rshiftNow && !rshiftPrev)
        toggleMenu();
    rshiftPrev = rshiftNow;

    // Menu rendering
    if (Hooks::instance().menuVisible())
        Menu::instance().render();

    // ── HUD overlay ────────────────────────────────────────────
    // Always draw a watermark + status so the user knows it's alive.
    ImGuiIO& io = ImGui::GetIO();
    ImDrawList* dl = ImGui::GetBackgroundDrawList();

    char fpsText[64];
    snprintf(fpsText, sizeof(fpsText), "ytclient | %.0f FPS", io.Framerate);
    ImVec2 fpsSize = ImGui::CalcTextSize(fpsText);
    float x = io.DisplaySize.x - fpsSize.x - 10.0f;
    float y = 6.0f;

    // Subtle dark background pill
    dl->AddRectFilled(
        ImVec2(x - 6, y - 3),
        ImVec2(x + fpsSize.x + 6, y + fpsSize.y + 3),
        IM_COL32(16, 12, 8, 140), 4.0f);

    // Amber accent dot when ready
    ImU32 dotCol = m_ready.load()
        ? IM_COL32(234, 176, 72, 255)   // amber = ready
        : IM_COL32(234, 72, 72, 255);    // red = loading
    dl->AddCircleFilled(ImVec2(x - 2, y + fpsSize.y * 0.5f), 3.0f, dotCol);

    dl->AddText(ImVec2(x, y), IM_COL32(230, 225, 215, 220), fpsText);

    // Draw HUD message if set (e.g. "ytclient loaded")
    if (m_hudMessage[0] != '\0')
    {
        ImVec2 msgSize = ImGui::CalcTextSize(m_hudMessage);
        dl->AddText(
            ImVec2(10, io.DisplaySize.y - msgSize.y - 10),
            IM_COL32(234, 176, 72, 100), m_hudMessage);
    }

    // Module overlays (ESP, tracers, etc.)
    if (m_ready.load())
        ModuleManager::instance().renderAll();
}

// ════════════════════════════════════════════════════════════
//  Tick callbacks
// ════════════════════════════════════════════════════════════
void Client::onTick()
{
    TickSync::instance().onTickStart();
}

void Client::onTickFallback()
{
    DWORD now = GetTickCount();
    m_tickAccumulator += (now - m_lastTickTime);
    m_lastTickTime = now;

    const DWORD tickInterval = 50;
    while (m_tickAccumulator >= tickInterval)
    {
        m_tickAccumulator -= tickInterval;
        TickSync::instance().onTickStart();
    }
}

// ════════════════════════════════════════════════════════════
//  Shutdown — called from DllMain (DLL_PROCESS_DETACH)
//  Waits for the background thread, then cleans up.
// ════════════════════════════════════════════════════════════
void Client::shutdown()
{
    // Signal the background thread to exit
    m_running = false;

    // Wait for it to wake up and finish
    if (m_thread.joinable())
        m_thread.join();

    m_ready = false;

    Hooks::instance().shutdown();
    PacketManager::instance().clearAll();
    JVM::instance().detach();

    if (GetConsoleWindow())
        FreeConsole();

    OutputDebugStringA("ytclient: unloaded\n");
}

void Client::toggleMenu()
{
    bool cur = Hooks::instance().menuVisible();
    Hooks::instance().setMenuVisible(!cur);
}

#pragma once
#include <Windows.h>
#include <atomic>
#include <thread>

class Client
{
public:
    static Client& instance();

    void startThread();  // Called from DllMain — spawns the background thread
    void shutdown();     // Called from DllMain — signals exit + cleans up

    bool isRunning() const { return m_running.load(); }
    bool isReady()   const { return m_ready.load(); }

    void toggleMenu();
    void onFirstFrame();  // Called from hkSwapBuffers (render thread)

    // For HUD overlay
    const char* hudMessage() const { return m_hudMessage; }

private:
    Client() = default;
    ~Client() = default;

    void run();

    std::atomic<bool> m_running{false};
    std::atomic<bool> m_ready{false};
    std::thread       m_thread;

    DWORD m_lastTickTime   = 0;
    DWORD m_tickAccumulator = 0;

    char m_hudMessage[256] = {};

    void onRender();
    void onTick();
    void onTickFallback();

    bool initJVM();
    bool initTickHook();
    void initModules();
};
