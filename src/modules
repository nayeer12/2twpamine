// ── Categories ───────────────────────────────────────────────
enum class Category : int
{
    Movement = 0,
    Combat   = 1,
    Player   = 2,
    Render   = 3,
    World    = 4,
    Misc     = 5
};

inline const char* categoryName(Category c)
{
    switch (c)
    {
    case Category::Movement: return "Movement";
    case Category::Combat:   return "Combat";
    case Category::Player:   return "Player";
    case Category::Render:   return "Render";
    case Category::World:    return "World";
    case Category::Misc:     return "Misc";
    }
    return "Unknown";
}

// ── Setting types ────────────────────────────────────────────
enum class SettingType
{
    Bool,
    Float,
    Int,
    Keybind
};

struct Setting
{
    std::string name;
    SettingType type;
    bool   boolVal   = false;
    float  floatVal  = 0.0f;
    float  floatMin  = 0.0f;
    float  floatMax  = 1.0f;
    int    intVal    = 0;
    int    intMin    = 0;
    int    intMax    = 100;
    int    keyVal    = 0;
};

// ── Base Module ──────────────────────────────────────────────
class Module
{
public:
    Module(std::string name, std::string desc, Category cat)
        : m_name(std::move(name)), m_desc(std::move(desc)), m_category(cat) {}
    virtual ~Module() = default;

    virtual void onEnable()  {}
    virtual void onDisable() {}
    virtual void onTick()    {}
    virtual void onRender()  {}

    void setEnabled(bool enabled)
    {
        if (m_enabled == enabled) return;
        m_enabled = enabled;
        if (enabled) onEnable();
        else onDisable();
    }

    bool isEnabled() const { return m_enabled; }
    void toggle() { setEnabled(!m_enabled); }

    const std::string& name() const { return m_name; }
    const std::string& desc() const { return m_desc; }
    Category category() const { return m_category; }

    // Settings
    Setting& addBool(const std::string& n, bool def)
    {
        m_settings.push_back({n, SettingType::Bool, def});
        return m_settings.back();
    }
    Setting& addFloat(const std::string& n, float def, float min, float max)
    {
        m_settings.push_back({n, SettingType::Float, false, def, min, max});
        return m_settings.back();
    }
    Setting& addInt(const std::string& n, int def, int min, int max)
    {
        m_settings.push_back({n, SettingType::Int, false, 0, 0, 0, def, min, max});
        return m_settings.back();
    }
    Setting& addKey(const std::string& n, int def)
    {
        m_settings.push_back({n, SettingType::Keybind, false, 0, 0, 0, 0, 0, 0, def});
        return m_settings.back();
    }

    std::vector<Setting>& settings() { return m_settings; }

    Setting* getSetting(const std::string& n)
    {
        for (auto& s : m_settings)
            if (s.name == n) return &s;
        return nullptr;
    }

    bool   getBool(const std::string& n, bool def = false)
    {
        auto* s = getSetting(n); return s ? s->boolVal : def;
    }
    float  getFloat(const std::string& n, float def = 0)
    {
        auto* s = getSetting(n); return s ? s->floatVal : def;
    }
    int    getInt(const std::string& n, int def = 0)
    {
        auto* s = getSetting(n); return s ? s->intVal : def;
    }

protected:
    std::string       m_name;
    std::string       m_desc;
    Category          m_category;
    bool              m_enabled = false;
    std::vector<Setting> m_settings;
};

#include "ModuleManager.h"
#include "../utils/Logger.h"

ModuleManager& ModuleManager::instance()
{
    static ModuleManager inst;
    return inst;
}

void ModuleManager::buildCategories()
{
    for (auto& mod : m_modules)
        m_byCategory[mod->category()].push_back(mod.get());
    m_categorized = true;
}

void ModuleManager::tickAll()
{
    if (!m_categorized) buildCategories();

    for (auto& mod : m_modules)
    {
        if (mod->isEnabled())
        {
            try { mod->onTick(); }
            catch (...) { LOG_WARN("Exception in " + mod->name() + "::onTick"); }
        }
    }
}

void ModuleManager::renderAll()
{
    if (!m_categorized) buildCategories();

    for (auto& mod : m_modules)
    {
        if (mod->isEnabled())
        {
            try { mod->onRender(); }
            catch (...) {}
        }
    }
}

std::vector<Module*>& ModuleManager::getByCategory(Category cat)
{
    if (!m_categorized) buildCategories();
    return m_byCategory[cat];
}

Module* ModuleManager::find(const std::string& name)
{
    for (auto& mod : m_modules)
        if (mod->name() == name) return mod.get();
    return nullptr;
}

#pragma once
#include "Module.h"
#include <vector>
#include <memory>
#include <functional>
#include <map>

class ModuleManager
{
public:
    static ModuleManager& instance();

    template<typename T, typename... Args>
    void add(Args&&... args)
    {
        auto mod = std::make_unique<T>(std::forward<Args>(args)...);
        m_modules.push_back(std::move(mod));
    }

    void tickAll();
    void renderAll();

    std::vector<Module*>& getByCategory(Category cat);

    const std::vector<std::unique_ptr<Module>>& all() const { return m_modules; }

    size_t size() const { return m_modules.size(); }

    Module* find(const std::string& name);

private:
    ModuleManager() = default;

    std::vector<std::unique_ptr<Module>> m_modules;
    std::map<Category, std::vector<Module*>> m_byCategory;
    bool m_categorized = false;

    void buildCategories();
};

#include "NoFall.h"
#include "../core/JVM.h"
#include "../core/Mappings.h"
#include "../packet/PacketManager.h"

void NoFall::onTick()
{
    auto& jvm = JVM::instance();
    JNIEnv* env = jvm.env();
    if (!env) return;

    jobject player = jvm.getPlayer();
    if (!player) return;

    jclass entityCls = jvm.findClass(Mappings::Cls::Entity);
    if (!entityCls) return;

    // Get velocity to check if falling
    jmethodID getVel = jvm.getMethodID(entityCls,
        Mappings::Entity::getVelocity, "()Lnet/minecraft/class_243;");
    if (!getVel) { env->DeleteLocalRef(entityCls); return; }

    jobject vel = env->CallObjectMethod(player, getVel);
    if (env->ExceptionCheck()) { env->ExceptionClear(); env->DeleteLocalRef(entityCls); return; }
    if (!vel) { env->DeleteLocalRef(entityCls); return; }

    jclass vecCls = jvm.findClass(Mappings::Cls::Vec3d);
    if (!vecCls) { env->DeleteLocalRef(entityCls); env->DeleteLocalRef(vel); return; }

    jmethodID getY = jvm.getMethodID(vecCls, Mappings::Vec3d::getY, "()D");
    if (!getY)
    {
        env->DeleteLocalRef(entityCls); env->DeleteLocalRef(vel); env->DeleteLocalRef(vecCls);
        return;
    }

    double vy = env->CallDoubleMethod(vel, getY);

    // If falling (negative Y velocity), queue an onGround packet
    if (vy < -0.3)
    {
        PacketManager::instance().sendOnGround(true);
    }

    env->DeleteLocalRef(entityCls);
    env->DeleteLocalRef(vel);
    env->DeleteLocalRef(vecCls);
}

