// Reach modifies the player's entity interaction range attribute.
// In 1.21.x this is an EntityAttribute instance on the player.
// We attempt field-level access; if the attribute system differs,
// the module gracefully no-ops.

void Reach::onEnable()
{
    auto& jvm = JVM::instance();
    JNIEnv* env = jvm.env();
    if (!env) return;

    jobject player = jvm.getPlayer();
    if (!player) return;

    // Try to access the attribute container
    jclass livingCls = jvm.findClass(Mappings::Cls::LivingEntity);
    if (!livingCls) return;

    // getAttributeContainer() -> method_6078 or similar
    // In 1.21.x: LivingEntity.getAttributeContainer()
    jmethodID getAttrContainer = jvm.getMethodID(livingCls,
        "method_6078", "()Lnet/minecraft/class_7134;");
    if (!getAttrContainer)
    {
        LOG_WARN("getAttributeContainer not found; Reach disabled");
        env->DeleteLocalRef(livingCls);
        setEnabled(false);
        return;
    }

    jobject container = env->CallObjectMethod(player, getAttrContainer);
    if (env->ExceptionCheck()) { env->ExceptionClear(); env->DeleteLocalRef(livingCls); return; }
    if (!container) { env->DeleteLocalRef(livingCls); return; }

    // AttributeContainer.getCustomInstance(EntityAttribute)
    // This requires the EntityAttributes.ENTITY_INTERACTION_RANGE registry entry
    // which is complex to resolve via JNI. As a simpler approach,
    // we set the field directly if accessible.

    LOG_INFO("Reach: attribute container obtained; range modification depends on attribute resolution");
    // TODO: Resolve EntityAttributes.ENTITY_INTERACTION_RANGE registry entry
    // and call getCustomInstance + setBaseValue

    env->DeleteLocalRef(livingCls);
    env->DeleteLocalRef(container);
}

void Reach::onDisable()
{
    // Restore would go here once attribute resolution is implemented
}

